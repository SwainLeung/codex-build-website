{
  "name": "codex-build-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && npm run test:gsc-evidence && npm run test:contracts",
    "test:gsc-evidence": "node --test scripts/verify-gsc-evidence.node-test.mjs",
    "check:gsc-evidence": "node scripts/verify-gsc-evidence.mjs",
    "check:contracts": "node scripts/verify-project-contracts.mjs",
    "test:contracts": "node --test scripts/verify-project-contracts.node-test.mjs",
    "check:content": "node scripts/verify-content.mjs && node scripts/verify-reference-hygiene.mjs && npm run check:gsc-evidence && npm run check:contracts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
